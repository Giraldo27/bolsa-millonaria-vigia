<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bolsa Millonaria 2026 — Informe de backtest y plan de juego</title>
<style>
:root{--bg:#f9f9f7;--surface:#fcfcfb;--ink:#0b0b0b;--ink2:#52514e;--muted:#898781;--line:#e1e0d9;--gain:#006300;--gainbg:#e6f4e6;--loss:#b32525;--lossbg:#fbeaea;
--warn:#8a5a00;--warnbg:#fff4d6;--accent:#2a78d6;--tsla:#2a78d6;--nvda:#eb6834;--eco:#4a3aa7;--shadow:0 1px 2px rgba(0,0,0,.06)}
@media (prefers-color-scheme:dark){:root{--bg:#0d0d0d;--surface:#1a1a19;--ink:#fff;--ink2:#c3c2b7;--muted:#898781;--line:#2c2c2a;--gain:#37c837;--gainbg:#12301a;--loss:#ff7b7b;--lossbg:#3a1616;
--warn:#fab219;--warnbg:#3a2e08;--accent:#3987e5;--tsla:#3987e5;--nvda:#d95926;--eco:#9085e9;--shadow:none}}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:64px}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--accent)}code{overflow-wrap:anywhere;font-size:.92em}
.layout{display:grid;grid-template-columns:240px minmax(0,1fr);max-width:1320px;margin:0 auto}
nav.toc{position:sticky;top:0;align-self:start;height:100vh;overflow:auto;padding:20px 12px 20px 20px;border-right:1px solid var(--line);font-size:14px}
nav.toc b{display:block;margin-bottom:8px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
nav.toc a{display:block;padding:5px 8px;border-radius:6px;color:var(--ink2);text-decoration:none}
nav.toc a:hover,nav.toc a.on{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
main{padding:24px 24px 80px;min-width:0}
section{margin:0 0 44px}
h1{font-size:clamp(26px,4vw,38px);line-height:1.15;margin:0 0 6px}
h2{font-size:clamp(21px,3vw,27px);margin:0 0 12px;padding-top:6px;border-top:2px solid var(--line)}
h3{font-size:18px;margin:22px 0 8px}
p{margin:.5em 0}.muted{color:var(--muted)}.small{font-size:14px}
.card,.box{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;box-shadow:var(--shadow)}
.verdict{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));margin:16px 0}
.sem{display:flex;gap:12px;align-items:flex-start}.sem .dot{font-size:34px;line-height:1}
.sem h3{margin:0 0 4px}
.grid2{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
ol.big,ul.big{padding-left:22px}.big li{margin:8px 0}
.kpis{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(310px,1fr))}
.kpi h4{margin:0 0 8px;font-size:15px;display:flex;gap:6px;align-items:center}
.kpi .row{display:flex;justify-content:space-between;gap:8px;padding:3px 0;border-bottom:1px dashed var(--line);font-size:14px}
.kpi .row:last-of-type{border-bottom:0}
.kpi .mean{margin:8px 0 0;font-size:13px;color:var(--ink2)}
.pos{color:var(--gain);font-weight:600}.neg{color:var(--loss);font-weight:600}.neu{color:var(--ink2)}
.tip{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:var(--line);color:var(--ink2);font-size:12px;cursor:help;position:relative;flex:none;font-style:normal;font-weight:600}
.tip:hover::after,.tip:focus::after{content:attr(data-tip);position:absolute;z-index:20;left:0;top:24px;width:min(300px,80vw);padding:10px 12px;background:var(--ink);color:var(--bg);border-radius:8px;font-size:13px;line-height:1.45;font-weight:400}
details{margin:8px 0;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
details summary{cursor:pointer;padding:9px 12px;font-weight:600;font-size:14px}
details .in{padding:2px 14px 12px;font-size:15px;color:var(--ink2)}
.chart{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px;overflow:hidden}
.warnbox{background:var(--warnbg);border:1px solid var(--warn);border-radius:10px;padding:12px 14px;margin:12px 0;color:var(--ink)}
.warnbox b:first-child{color:var(--warn)}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{padding:8px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{text-align:left}th{background:var(--bg);position:sticky;top:0;font-size:13px;color:var(--ink2)}
td.l,th.l{text-align:left;white-space:normal}
tr.hl td{background:var(--gainbg)}tbody tr:hover td{background:rgba(137,135,129,.1)}
.pill{display:inline-block;padding:1px 8px;border-radius:99px;font-size:12px;font-weight:600}
.pill.pos{background:var(--gainbg)}.pill.neg{background:var(--lossbg)}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}
select,button,input{font:inherit;padding:7px 10px;border-radius:8px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
button{cursor:pointer}button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:14px;margin:6px 0}.sw{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:5px;vertical-align:-1px}
pre.msg{background:#0f1f2e;color:#e6edf3;padding:14px;border-radius:10px;overflow:auto;font:14px/1.5 ui-monospace,Consolas,monospace;white-space:pre-wrap}
dl.gl dt{font-weight:700;margin-top:12px}dl.gl dd{margin:2px 0 0;color:var(--ink2)}
svg text{font-family:system-ui,sans-serif}
.flow{width:100%;height:auto}
.badge{font-size:12px;background:var(--line);padding:2px 8px;border-radius:99px;color:var(--ink2)}
footer{color:var(--muted);font-size:13px;padding:20px 24px 40px;max-width:1320px;margin:0 auto}
@media (max-width:900px){.layout{display:block}
nav.toc{position:sticky;top:0;z-index:30;height:auto;display:flex;gap:6px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line);background:var(--bg);padding:8px 12px;white-space:nowrap}
nav.toc b{display:none}nav.toc a{padding:6px 10px;border:1px solid var(--line);border-radius:99px;font-size:13px}
main{padding:16px 14px 60px}th,td{padding:7px 8px}}
</style>
</head>
<body>
{% set f = fmt %}
{% macro tip(t) %}<i class="tip" tabindex="0" data-tip="{{ t }}">ⓘ</i>{% endmacro %}
{% macro fig(html, how, means) %}
<div class="chart">{{ html|safe }}</div>
<details><summary>📖 Cómo leer este gráfico</summary><div class="in">{{ how|safe }}</div></details>
<details><summary>💡 Qué significa para ti</summary><div class="in">{{ means|safe }}</div></details>
{% endmacro %}
{% macro warn(t) %}<div class="warnbox"><b>⚠️ Cuidado.</b> {{ t|safe }}</div>{% endmacro %}
<div class="layout">
<nav class="toc" aria-label="Índice">
<b>Contenido</b>
<a href="#s1">1 · Veredicto</a><a href="#s2">2 · Métricas clave</a><a href="#s3">3 · Simulación del concurso</a>
<a href="#s4">4 · Robustez estadística</a><a href="#s5">5 · Cómo funciona</a><a href="#s6">6 · ¿Buenos activos?</a>
<a href="#s7">7 · Una operación</a><a href="#s8">8 · Resultados generales</a><a href="#s9">9 · Por setup y activo</a>
<a href="#s10">10 · Qué mejoramos</a><a href="#s11">11 · Riesgos</a><a href="#s12">12 · Reglas finales</a>
<a href="#s13">13 · Automatización</a><a href="#s14">14 · Bitácora</a><a href="#s15">15 · Glosario</a>
</nav>
<main>

<section id="s1">
<h1>Bolsa Millonaria 2026: ¿funciona la estrategia y cómo ganar?</h1>
<p class="muted small">Informe generado el {{ hoy.strftime('%d/%m/%Y') }} · Datos de Yahoo Finance hasta el 02/10/2026 · Capital simulado: {{ f.cop(capital) }} · Concurso: 5-oct al 6-nov de 2026 (23 sesiones)</p>
<div class="verdict">
 <div class="card sem"><div class="dot">🔴</div><div><h3>Sistema original (setups A, B y C con TP/SL)</h3>
  <p><b>No es rentable.</b> Entre 2015 y 2026 habría perdido entre {{ f.pct(-v.rent_max,0) }} y {{ f.pct(-v.rent_min,0) }} del capital. Antes de costos empata; los costos (≈ {{ f.pct(v.costo_trade,1) }} por operación) se comen todo.</p></div></div>
 <div class="card sem"><div class="dot">🟡</div><div><h3>Plan final (concentrar en la acción más volátil)</h3>
  <p><b>Depende.</b> No es una estrategia “segura”: es una apuesta concentrada, con una ventaja estadística pequeña y mucha varianza, diseñada para maximizar la probabilidad de terminar arriba del ranking, no el retorno promedio.</p></div></div>
</div>
<div class="grid2">
<div class="box"><h3>Los 3 hallazgos principales</h3><ol class="big">
<li><b>El sistema original pierde por costos, no por mala suerte.</b> Su acierto real fue de {{ f.pct(v.win_min,0) }}–{{ f.pct(v.win_max,0) }} frente al 43–44 % mínimo necesario, y cada operación perdió en promedio {{ f.pct(-v.exp_orig,1) }}.</li>
<li><b>Ajustar parámetros no lo salva.</b> De las {{ n_cells }} combinaciones TP×SL probadas, {{ cells_pos_oos }} {{ 'fue rentable' if cells_pos_oos == 1 else 'fueron rentables' }} fuera de muestra. Las mejoras validadas reducen la pérdida por operación de {{ f.pct(v.exp_orig,2,True) }} a {{ f.pct(v.exp_mej,2,True) }}, pero el resultado sigue sin ser estadísticamente distinto de cero.</li>
<li><b>Para <i>ganar</i> hay que concentrar, no proteger.</b> Comprar y mantener una sola acción muy volátil tuvo ≈ {{ f.pct(plan_a.campeon,0) }} de probabilidad de “campeón” (pasar los 4 cortes y terminar #1) frente a rivales sintéticos, contra ≈ 0,1 % del azar puro. Reducir exposición al ir liderando la baja a ≈ {{ f.pct(matrix.con,0) }}.</li></ol></div>
<div class="box"><h3>Las 3 acciones que debes tomar</h3><ol class="big">
<li><b>Lunes 5-oct, al abrir:</b> compra <b>{{ selected }}</b> con el <b>100 %</b> del capital (orden a mercado).</li>
<li><b>Cada sesión:</b> haz tu micro-compra de actividad (el 15 % del puntaje) si ese día no compras otra cosa, antes de las 14:40.</li>
<li><b>No toques nada más:</b> sin stops, sin cambiar de acción, sin reducir al ir ganando. Recibe el aviso de las 14:30 por Telegram y mantén la posición hasta el 6-nov.</li></ol></div>
</div>
{{ warn("Esto es un análisis histórico, no una promesa. El universo permitido incluye ganadores extremos conocidos hoy (NVDA ≈ ×650 en pesos desde 2015), y esa ventaja retrospectiva no se puede asumir hacia adelante. Con el plan final, en ≈ " ~ f.pct(p_lt10,0) ~ " de las ventanas históricas habrías perdido más de 10 %.") }}
</section>

<section id="s2">
<h2>2 · Panel de métricas clave</h2>
<p>Cada tarjeta compara los cuatro modos de riesgo del <b>sistema original</b> (2015–2026, con interés compuesto). Pasa el mouse o toca el ⓘ para ver la definición. Las pérdidas se muestran en <span class="neg">rojo</span> y las ganancias en <span class="pos">verde</span>.</p>
<div class="kpis">
{% for c in cards %}
<div class="card kpi"><h4>{{ c.t }} {{ tip(c.tip) }}</h4>
{% for r in c.vals %}<div class="row"><span>{{ r.modo }}</span><span class="{{ r.c }}">{{ r.v }}</span></div>{% endfor %}
<p class="mean"><b>Qué significa:</b> {{ c.mean }}</p></div>
{% endfor %}
</div>
</section>

<section id="s3">
<h2>3 · Simulación del concurso</h2>
<p>El concurso dura 23 sesiones. Para saber qué esperar, tomamos <b>todas las ventanas de 23 sesiones</b> desde 2015 (cada una empieza con $ 100.000.000) y vemos cómo habría terminado cada estrategia.</p>
{{ fig(hist_html,
 "Cada barra cuenta qué porcentaje de las ventanas terminó con ese retorno. Más a la derecha = más ganancia. Haz clic en la leyenda para mostrar u ocultar estrategias.",
 "El sistema original se concentra en pérdidas pequeñas (a la izquierda del cero). El plan final está mucho más repartido: pierde y gana más, con una cola larga a la derecha. En un concurso por ranking, esa cola es la que te puede poner de primero.") }}
<h3>Estadísticas de las ventanas de 23 sesiones</h3>
<div class="tablewrap"><table><thead><tr><th>Estrategia</th><th>Media</th><th>Mediana</th><th>Percentil 10 {{ tip("El 10 % de las ventanas termina peor que este valor.") }}</th><th>Percentil 90 {{ tip("El 10 % de las ventanas termina mejor que este valor.") }}</th><th>&gt; 0 %</th><th>&gt; 3 %</th><th>&gt; 10 %</th></tr></thead><tbody>
{% for r in win_rows %}<tr><td>{{ r.nombre }}</td><td class="{{ f.cls(r.media) }}">{{ f.pct(r.media,1,True) }}</td><td class="{{ f.cls(r.mediana) }}">{{ f.pct(r.mediana,1,True) }}</td><td class="{{ f.cls(r.p10) }}">{{ f.pct(r.p10,1,True) }}</td><td class="{{ f.cls(r.p90) }}">{{ f.pct(r.p90,1,True) }}</td><td>{{ f.pct(r.gt0,0) }}</td><td>{{ f.pct(r.gt3,0) }}</td><td>{{ f.pct(r.gt10,0) }}</td></tr>{% endfor %}
</tbody></table></div>
{{ warn("Las ventanas del sistema original liquidan las posiciones abiertas el último día (pagan costos de venta); las del plan final y de “comprar y mantener TSLA” se valoran a mercado sin vender. Además, 2015–2026 tuvo ganadores extremos en el universo (NVDA, TSLA), lo que mejora artificialmente a las estrategias concentradas.") }}
<h3>Simulador de ligas: probabilidad de pasar cada corte</h3>
<p>Simulamos 1.000 participantes sintéticos con carteras concentradas de 2 a 4 activos al azar. Para ascender hay que estar en el <b>top 30 %</b> en los cortes 1 y 2 y en el <b>top 10 %</b> en los cortes 3 y 4; “campeón” = pasar los cuatro y terminar #1.</p>
{{ fig(liga_html,
 "Cada grupo de barras es una etapa; la altura es la probabilidad de haber superado todas las etapas hasta ahí. Cae a medida que el filtro se vuelve más exigente.",
 "El plan final llega más lejos que los sistemas con TP/SL: ≈ " ~ f.pct(plan_a.pasa_20,0) ~ " pasa los 4 cortes y ≈ " ~ f.pct(plan_a.campeon,0) ~ " termina #1 frente al campo amplio (≈ " ~ f.pct(plan_m.campeon,0) ~ " frente a rivales que sólo operan acciones MGC). Son estimaciones, no garantías: los rivales reales operan activamente.") }}
</section>

<section id="s4">
<h2>4 · Robustez estadística</h2>
<p>¿Los resultados son reales o son suerte? Estas pruebas lo miden. Cada número viene con su explicación de una línea.</p>
<h3>Intervalo de confianza de la expectancy por operación</h3>
{{ fig(boot_html,
 "Cada punto es lo que ganó (o perdió) en promedio una operación; la línea es el rango plausible al 95 % (bootstrap: se remuestrean las operaciones 10.000 veces). Si la línea no cruza el cero, el resultado no se explica por azar.",
 "El sistema original perdió de forma estadísticamente clara en tres de sus cuatro modos (la línea completa queda a la izquierda del 0). Con las mejoras la pérdida se acerca a cero, pero el intervalo ya cruza el cero: <b>mejor, aunque no demostrablemente rentable</b>.") }}
<div class="tablewrap"><table><thead><tr><th>Medida</th><th>Original · Blindaje</th><th>Mejorado · Blindaje</th><th class="l">Qué significa</th></tr></thead><tbody>
<tr><td>Expectancy por trade</td><td class="neg">{{ f.pct(rob.bavd_o.media,2,True) }}</td><td class="{{ f.cls(rob.bavd_m.media) }}">{{ f.pct(rob.bavd_m.media,2,True) }}</td><td class="l">Resultado promedio de cada operación, ya con costos.</td></tr>
<tr><td>Intervalo de confianza 95 %</td><td>{{ f.pct(rob.bavd_o.ic_lo,2,True) }} a {{ f.pct(rob.bavd_o.ic_hi,2,True) }}</td><td>{{ f.pct(rob.bavd_m.ic_lo,2,True) }} a {{ f.pct(rob.bavd_m.ic_hi,2,True) }}</td><td class="l">Rango en el que está, con 95 % de confianza, el verdadero resultado medio.</td></tr>
<tr><td>p-valor vs. 0</td><td>{{ f.num(rob.bavd_o.p_t,3) }}</td><td>{{ f.num(rob.bavd_m.p_t,2) }}</td><td class="l">Probabilidad de ver un resultado así si la estrategia en realidad no tuviera efecto. Menor que 0,05 = difícil de atribuir al azar.</td></tr>
<tr><td>Percentil vs. estrategia aleatoria</td><td>{{ f.pct(rob.mavd_o.percentil,1) }}</td><td>{{ f.pct(rob.mavd_m.percentil,1) }}</td><td class="l">Porcentaje de 1.000 estrategias aleatorias (mismos trades y costos) que rindió menos. 50 % = igual que el azar.</td></tr>
</tbody></table></div>
<h3>Contra el azar</h3>
{{ fig(mc_html,
 "El histograma muestra el retorno medio por trade de 1.000 estrategias que compran en fechas aleatorias, con los mismos activos, duración y costos. La línea roja es el sistema original.",
 "El sistema original rindió <b>peor</b> que la mayoría de las estrategias aleatorias (percentil " ~ f.pct(rob.mavd_o.percentil,0) ~ "): sus reglas de entrada y de TP/SL no agregan valor, sólo pagan costos.") }}
<h3>Dentro vs. fuera de muestra</h3>
<p>Optimizamos con datos hasta 2021 y validamos con 2022–2026. Cada tramo arranca con capital nuevo.</p>
<div class="tablewrap"><table><thead><tr><th>Modo</th><th class="l">Periodo</th><th>Trades</th><th>Acierto</th><th>Expectancy</th><th>P&amp;L neto</th></tr></thead><tbody>
{% for r in oos_rows %}<tr><td>{{ r.modo }}</td><td class="l">{{ r.periodo }}</td><td>{{ r.n }}</td><td>{{ f.pct(r.win,0) }}</td><td class="{{ f.cls(r.exp) }}">{{ f.pct(r.exp,2,True) }}</td><td class="{{ f.cls(r.pnl) }}">{{ f.cop_m(r.pnl,0) }}</td></tr>{% endfor %}
</tbody></table></div>
<div class="box" style="margin-top:12px"><b>Plan final:</b> retorno medio por ventana {{ f.pct(plan_stats.media,1,True) }}; promedios anuales positivos en {{ plan_years_pos }} de {{ plan_years }} años; intervalo 95 % de la media anual (bootstrap sobre años) {{ f.pct(plan_ci[0],1,True) }} a {{ f.pct(plan_ci[1],1,True) }}. {{ warn("Son sólo 12 años (y 12 observaciones): el intervalo es estrecho en apariencia, pero depende de que TSLA/NVDA y su régimen se repitan. Sin esa ventaja retrospectiva no puedo asegurar un retorno positivo.") }}</div>
</section>

<section id="s5">
<h2>5 · Cómo funciona la estrategia</h2>
<h3>Plan final</h3>
<div class="chart" style="padding:12px">
<svg class="flow" viewBox="0 0 900 330" role="img" aria-label="Diagrama del plan final">
<defs><marker id="ar" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#898781"/></marker></defs>
<g font-size="14" fill="currentColor" stroke="none">
<rect x="10" y="20" width="200" height="70" rx="10" fill="none" stroke="#898781" stroke-width="1.5"/>
<text x="110" y="48" text-anchor="middle" font-weight="700">Antes (fin de semana)</text><text x="110" y="70" text-anchor="middle">Ranking por volatilidad</text>
<rect x="250" y="20" width="200" height="70" rx="10" fill="none" stroke="#2a78d6" stroke-width="2"/>
<text x="350" y="48" text-anchor="middle" font-weight="700">Lunes 5-oct (apertura)</text><text x="350" y="70" text-anchor="middle">Comprar {{ selected }} al 100 %</text>
<rect x="490" y="20" width="200" height="70" rx="10" fill="none" stroke="#898781" stroke-width="1.5"/>
<text x="590" y="48" text-anchor="middle" font-weight="700">Cada sesión</text><text x="590" y="70" text-anchor="middle">Micro-compra de actividad</text>
<rect x="730" y="20" width="160" height="70" rx="10" fill="none" stroke="#898781" stroke-width="1.5"/>
<text x="810" y="48" text-anchor="middle" font-weight="700">6-nov</text><text x="810" y="70" text-anchor="middle">Valoración final</text>
<path d="M210,55 H245" stroke="#898781" stroke-width="2" marker-end="url(#ar)"/><path d="M450,55 H485" stroke="#898781" stroke-width="2" marker-end="url(#ar)"/><path d="M690,55 H725" stroke="#898781" stroke-width="2" marker-end="url(#ar)"/>
<text x="450" y="140" text-anchor="middle" font-weight="700">Durante el concurso: ¿qué hago si…?</text>
<rect x="10" y="155" width="205" height="82" rx="10" fill="none" stroke="#898781"/><text x="112" y="180" text-anchor="middle" font-weight="700">Corte semanal</text><text x="112" y="202" text-anchor="middle">Mirar mi percentil</text><text x="112" y="222" text-anchor="middle">y NO reducir</text>
<rect x="232" y="155" width="205" height="82" rx="10" fill="none" stroke="#898781"/><text x="334" y="180" text-anchor="middle" font-weight="700">Cae 15 % o más</text><text x="334" y="202" text-anchor="middle">Aviso informativo;</text><text x="334" y="222" text-anchor="middle">el plan no vende</text>
<rect x="454" y="155" width="205" height="82" rx="10" fill="none" stroke="#898781"/><text x="556" y="180" text-anchor="middle" font-weight="700">Reporte de resultados</text><text x="556" y="202" text-anchor="middle">Mantener a través</text><text x="556" y="222" text-anchor="middle">del reporte</text>
<rect x="676" y="155" width="214" height="82" rx="10" fill="none" stroke="#898781"/><text x="783" y="180" text-anchor="middle" font-weight="700">Cambia el ranking</text><text x="783" y="202" text-anchor="middle">NO cambiar de acción:</text><text x="783" y="222" text-anchor="middle">se elige el primer día</text>
